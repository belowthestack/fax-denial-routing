{
  "name": "[lab-ops-command-center] WF-1 Fax Poll to Intake",
  "nodes": [
    {
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        240,
        300
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "name": "List unhandled faxes (provider placeholder)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        520,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-FAX-PROVIDER/api",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "YOUR_FAX_USERNAME"
            },
            {
              "name": "company",
              "value": "YOUR_FAX_COMPANY"
            },
            {
              "name": "password",
              "value": "YOUR_FAX_PASSWORD"
            },
            {
              "name": "operation",
              "value": "listfax"
            },
            {
              "name": "unhandled",
              "value": "1"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "text"
            }
          }
        }
      }
    },
    {
      "name": "Parse fax list",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const body = String($input.first().json.data || '');\nif (body.startsWith('ERR')) throw new Error('Fax provider rejected the login: ' + body.slice(0, 40));\nreturn body.split('\\n').map(l => l.split('\\t')).filter(p => p.length >= 4 && p[0].trim()).map(p => ({ json: { faxid: p[0].trim(), received: p[1] } }));"
      }
    },
    {
      "name": "Fetch fax PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1080,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-FAX-PROVIDER/api",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "YOUR_FAX_USERNAME"
            },
            {
              "name": "company",
              "value": "YOUR_FAX_COMPANY"
            },
            {
              "name": "password",
              "value": "YOUR_FAX_PASSWORD"
            },
            {
              "name": "operation",
              "value": "getfax"
            },
            {
              "name": "faxid",
              "value": "={{ $json.faxid }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      }
    },
    {
      "name": "POST to intake API (idempotent)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1360,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-FAX-SERVICE-HOST/api/intake/raw",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "source",
              "value": "faxprovider"
            },
            {
              "name": "source_id",
              "value": "={{ $('Parse fax list').item.json.faxid }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "timeout": 60000
        }
      }
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "List unhandled faxes (provider placeholder)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List unhandled faxes (provider placeholder)": {
      "main": [
        [
          {
            "node": "Parse fax list",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse fax list": {
      "main": [
        [
          {
            "node": "Fetch fax PDF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch fax PDF": {
      "main": [
        [
          {
            "node": "POST to intake API (idempotent)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
